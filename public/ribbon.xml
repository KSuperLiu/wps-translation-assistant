<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnTranslationLoad">
  <ribbon startFromScratch="false"><tabs>
    <tab id="TranslationAssistantTab" label="翻译助手">
      <group id="TranslationWorkspaceGroup" label="翻译面板">
        <button id="TranslationOpen" label="打开助手" size="large"
                getImage="OnTranslationGetImage" onAction="OnTranslationAction"
                screentip="打开翻译助手侧栏"
                supertip="确认翻译任务，对照原文变化，逐条翻译或修订。" />
      </group>
      <group id="TranslationQualityGroup" label="任务流程">
        <button id="TranslationNext" label="下一条待处理" size="large"
                getImage="OnTranslationGetImage" onAction="OnTranslationAction"
                screentip="定位下一条需填写或修复的译文"
                supertip="在当前工作表与搜索范围内连续处理，空原文另列为需核实。" />
        <button id="TranslationScan" label="交付检查" size="large"
                getImage="OnTranslationGetImage" onAction="OnTranslationAction"
                screentip="重新扫描全工作簿，查看交付前剩余事项"
                supertip="核实未填写、格式问题、缺失原文、识别提示和侧栏未写入草稿。" />
      </group>
    </tab>
  </tabs></ribbon>
</customUI>
